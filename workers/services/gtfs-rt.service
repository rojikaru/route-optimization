[Unit]
Description=GTFS-RT collector
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=gtfs
Group=gtfs
WorkingDirectory=/var/lib/gtfs
EnvironmentFile=/etc/gtfs/collector.env
ExecStart=/usr/bin/bun run /opt/route-optimization/workers/collector/index.ts

Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

MemoryMin=64M
MemoryMax=256M
MemorySwapMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gtfs

[Install]
WantedBy=multi-user.target
